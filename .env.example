# dsproxy — example configuration. Every variable is optional.
# Copy to .env (loaded automatically, gitignored) and override as needed.

# ── HTTP server ──
DSPROXY_HOST=127.0.0.1
DSPROXY_PORT=9655
# Bearer / x-api-key token required by every non-probe endpoint.
# Strongly recommended whenever DSPROXY_HOST is not a loopback address.
# DSPROXY_API_KEY=replace-with-a-long-random-value
# DSPROXY_API_KEY_FILE=/run/secrets/proxy-api-key
# Refuse to start without an API key (the Containerfile enables this).
DSPROXY_REQUIRE_API_KEY=0
# Extra browser origins (comma separated). Loopback origins are always allowed.
# DSPROXY_CORS_ORIGINS=https://ui.example.com,http://192.168.1.20:3000
DSPROXY_MAX_CONCURRENT=24
DSPROXY_REQUEST_DEADLINE_MS=120000

# ── Accounts ──
# One file, a comma separated list of files, or a directory of *.json files.
DSPROXY_AUTH_PATH=./deepseek-auth.json
# DSPROXY_AUTH_DIR=./data/accounts
DSPROXY_ACCOUNT_COOLDOWN_MS=600000

# ── Upstream (chat.deepseek.com) ──
DSPROXY_FETCH_TIMEOUT_MS=30000
DSPROXY_COMPLETION_TIMEOUT_MS=120000
DSPROXY_LOCALE=en
# DSPROXY_USER_AGENT=

# ── Long agent sessions ──
DSPROXY_MAX_PROMPT_CHARS=80000
DSPROXY_MAX_RETRIES=2

# ── Misc ──
# debug | info | warn | error
DSPROXY_LOG_LEVEL=info
# Token used by `dsproxy import` when importing a browser cookie export.
# DSPROXY_TOKEN=

# ── Chrome auth helper (`dsproxy auth`) ──
# DSPROXY_CHROME_PATH=
# DSPROXY_CHROME_PORT=9334
# DSPROXY_CHROME_PROFILE=
# DSPROXY_KEEP_PROFILE=0
